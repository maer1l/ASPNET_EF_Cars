@model ASPNET_EF_Cars.ViewModels.CarViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Cars categories";
}

<table class="table">
    <thead>
        <tr>
            <th>
                <label>Car</label>
            </th>
            <th>
                <label>Category</label>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.cars)
        {
            <tr>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CarId">@Html.DisplayFor(modelItem => item.Brand) @Html.DisplayFor(modelItem => item.Model)</a>
                </td>
                <td>
                    @Model.categories.FirstOrDefault(c => c.CategoryId == item.CategoryId).Title
                </td>
            </tr>
        }
    </tbody>
</table>
