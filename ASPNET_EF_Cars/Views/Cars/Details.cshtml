@model ASPNET_EF_Cars.ViewModels.CarCategory

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<h4>Car</h4>
<div class="container">
    <div class="details-grid">
        <div class="detail-item">
            <div class="detail-label">@Html.DisplayNameFor(model => model.car.Brand)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.car.Brand)</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">@Html.DisplayNameFor(model => model.car.Model)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.car.Model)</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">@Html.DisplayNameFor(model => model.car.Speed)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.car.Speed)</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">@Html.DisplayNameFor(model => model.car.Price)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.car.Price)</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">@Html.DisplayNameFor(model => model.car.Year)</div>
            <div class="detail-value">@Html.DisplayFor(model => model.car.Year)</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">Категория</div>
            <div class="detail-value">@Model.categories.FirstOrDefault(c => c.CategoryId == Model.car.CategoryId)?.Title</div>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.car.CarId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
